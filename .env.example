# =============================================================================
# AdvisorAI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# FREE services you can use right now (no billing required):
#   ✅ Groq API       → get free key at console.groq.com
#   ✅ SentenceTransformers → downloads automatically on first run
#   ✅ PostgreSQL     → runs in Docker (see docker-compose.yml)
#   ✅ Redis          → runs in Docker
#   ✅ MinIO          → runs in Docker (replaces AWS S3 for free)
#   ✅ spaCy + scikit-learn → installed from requirements.txt
#
# Optional paid services:
#   💰 OpenAI         → only needed if GROQ_API_KEY is empty
#   💰 AWS S3         → MinIO is a free local replacement (already in Docker)
#   💰 Sentry         → optional monitoring (free tier at sentry.io)
# =============================================================================

# ── Application ───────────────────────────────────────────────
APP_NAME="AdvisorAI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# ── Security (CHANGE THESE IN PRODUCTION) ────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-me-in-production-use-a-long-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL + pgvector) ─────────────────────────
# Docker default (see docker-compose.yml):
DATABASE_URL="postgresql+asyncpg://sme_user:sme_password@localhost:5432/sme_kb"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ── Redis ─────────────────────────────────────────────────────
# FREE — runs in Docker
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=3600

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ── File Storage ─────────────────────────────────────────────
# Option A (FREE): MinIO running in Docker
#   S3_ENDPOINT_URL points to local MinIO — no AWS account needed
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="sme-kb-documents"
S3_ENDPOINT_URL="http://localhost:9000"

# Option B (Paid): Real AWS S3
#   Uncomment and fill in your AWS credentials, remove S3_ENDPOINT_URL
# AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
# AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME="your-bucket-name"

# ── AI / LLM — FREE via Groq ──────────────────────────────────
# Get your free API key at: https://console.groq.com
# Free tier: 14,400 requests/day, 30 req/min — plenty for development
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="llama-3.1-70b-versatile"

# ── Embeddings — FREE, runs locally ──────────────────────────
# SentenceTransformers model is downloaded once, then cached locally
# No API key required — runs on CPU with no cost
HUGGINGFACE_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# ── RAG pipeline configuration ────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8
RAG_RERANK_TOP_N=4

# ── Document upload limits ────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=".pdf,.docx,.xlsx,.doc,.xls,.txt"

# ── Email notifications ───────────────────────────────────────
# FREE: Gmail SMTP (enable "App Passwords" in your Google account)
# Instructions: myaccount.google.com → Security → App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
EMAILS_FROM_EMAIL="noreply@advisorai.app"

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Webhooks ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
WEBHOOK_SECRET="change-me-webhook-secret"

# ── Feature flags ─────────────────────────────────────────────
ENABLE_RATE_LIMITING=True
ENABLE_AUDIT_LOG=True

# ── Optional: Sentry monitoring (free tier at sentry.io) ─────
# SENTRY_DSN="https://xxxx@xxxxxx.ingest.sentry.io/xxxx"

# ── Optional: OpenAI fallback (only if GROQ_API_KEY is empty) ─
# OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# OPENAI_MODEL="gpt-4-turbo-preview"

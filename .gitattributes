# Force LF line endings for all files that must not have CRLF.
# Windows git auto-converts to CRLF on checkout by default — this prevents
# Docker image build failures and Python runtime errors on all platforms.

# Default: normalise to LF on commit, keep as-is on checkout
* text=auto eol=lf

# Explicitly LF — these MUST be LF or they break inside Linux containers
Dockerfile          text eol=lf
*.sh                text eol=lf
*.py                text eol=lf
*.toml              text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.ini               text eol=lf
*.cfg               text eol=lf
*.sql               text eol=lf
*.env               text eol=lf
*.env.example       text eol=lf
Makefile            text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.pkl  binary
*.pt   binary
*.pth  binary
*.h5   binary
*.onnx binary
*.whl  binary
*.zip  binary
*.tar  binary
*.gz   binary

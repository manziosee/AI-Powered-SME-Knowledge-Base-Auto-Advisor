              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/bulk-upload",
              "host": ["{{base_url}}"],
              "path": ["documents", "bulk-upload"]
            },
            "description": "Upload up to 20 files in one request. Each file is validated, version-tracked, and processed asynchronously. Returns {uploaded, failed, errors, documents[]}."
          }

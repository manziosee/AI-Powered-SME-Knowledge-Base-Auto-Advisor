        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/?search=&doc_type=",
              "host": ["{{base_url}}"],
              "path": ["documents", ""],
              "query": [
                { "key": "search", "value": "", "description": "Full-text search" },
                { "key": "doc_type", "value": "", "description": "contract | policy | invoice | hr_document | compliance | other" }
              ]
            }
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/:document_id",
              "host": ["{{base_url}}"],
              "path": ["documents", ":document_id"],
              "variable": [{ "key": "document_id", "value": "your-document-uuid" }]
            }
          }
        },
        {
          "name": "Get Download URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/:document_id/download",
              "host": ["{{base_url}}"],
              "path": ["documents", ":document_id", "download"],
              "variable": [{ "key": "document_id", "value": "your-document-uuid" }]
            }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/:document_id",
              "host": ["{{base_url}}"],
              "path": ["documents", ":document_id"],
              "variable": [{ "key": "document_id", "value": "your-document-uuid" }]
            }
          }
        }
      ]
    },
